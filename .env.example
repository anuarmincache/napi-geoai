# Copie para `.env` na raiz do repositório.
# Os scripts Python (migrate/import) carregam `.env` via load_dotenv_file().
# Alternativa: exportar no shell — `export DATABASE_URL=...` (bash) /
# `$env:DATABASE_URL='...'` (PowerShell). Copiar o arquivo sozinho não injeta
# variáveis em processos que não leem `.env`.
#
# NÃO use connection strings da conta Supabase remota neste MVP.

# WSL Ubuntu nativo (recomendado). Se a 5432 estiver ocupada na instalação,
# o cluster pode subir em 5433 — confira com: pg_lsclusters
DATABASE_URL=postgresql://napi:napi_local_dev_only@127.0.0.1:5433/napi_geoai
# Compose / CI usam 5432:
# DATABASE_URL=postgresql://napi:napi_local_dev_only@127.0.0.1:5432/napi_geoai

# Opcional: schema de aplicação (padrão: geoai)
GEOAI_DB_SCHEMA=geoai
